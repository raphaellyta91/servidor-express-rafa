<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Lista de Cursos</title>
</head>
<body>

  <h1>Lista de Cursos</h1>

  <a href="/cadastro">Cadastrar novo curso</a>
  <br><br>

  <table border="1">
    <tr>
      <th>ID</th>
      <th>Código</th>
      <th>Curso</th>
      <th>Carga Horária</th>
      <th>Tipo</th>
      <th>Ação</th>
    </tr>

    <% cursos.forEach(curso => { %>
      <tr>
        <td><%= curso.idCurso %></td>
        <td><%= curso.cod %></td>
        <td><%= curso.curso %></td>
        <td><%= curso.ch %></td>
        <td><%= curso.tipo %></td>
        <td>
          <a href="/curso/remover/<%= curso.idCurso %>">Remover</a>
        </td>
      </tr>
    <% }) %>
  </table>

</body>
</html>